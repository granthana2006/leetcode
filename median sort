#include <limits.h>

double findMedianSortedArrays(int* nums1, int nums1Size,
                              int* nums2, int nums2Size) {

    // Always perform binary search on the smaller array
    if (nums1Size > nums2Size) {
        return findMedianSortedArrays(nums2, nums2Size,
                                      nums1, nums1Size);
    }

    int m = nums1Size;
    int n = nums2Size;

    int low = 0;
    int high = m;

    while (low <= high) {

        // Partition of nums1
        int partition1 = (low + high) / 2;

        // Partition of nums2
        int partition2 = (m + n + 1) / 2 - partition1;

        // Values around partition in nums1
        int left1 = (partition1 == 0)
                    ? INT_MIN
                    : nums1[partition1 - 1];

        int right1 = (partition1 == m)
                     ? INT_MAX
                     : nums1[partition1];

        // Values around partition in nums2
        int left2 = (partition2 == 0)
                    ? INT_MIN
                    : nums2[partition2 - 1];

        int right2 = (partition2 == n)
                     ? INT_MAX
                     : nums2[partition2];

        // Correct partition
        if (left1 <= right2 && left2 <= right1) {

            // Total number of elements is odd
            if ((m + n) % 2 == 1) {
                return (double)(left1 > left2 ? left1 : left2);
            }

            // Total number of elements is even
            int maxLeft = left1 > left2 ? left1 : left2;
            int minRight = right1 < right2 ? right1 : right2;

            return (maxLeft + minRight) / 2.0;
        }

        // partition1 is too far right
        else if (left1 > right2) {
            high = partition1 - 1;
        }

        // partition1 is too far left
        else {
            low = partition1 + 1;
        }
    }

    return 0.0;
}
